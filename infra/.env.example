# 复制为仓库根目录 .env 后按需修改。业务数据写在 DATA_DIR 下的 JSON 文件。
DATA_DIR=data/store
REDIS_URL=redis://127.0.0.1:6379/0
JWT_SECRET=dev-only-not-for-production-key!!
JWT_EXPIRE_MINUTES=1440
USE_MOCK_AI=true
USE_MOCK_STORAGE=true
TASK_INLINE=true
SEED_DEMO=true
DEMO_EMAIL=demo@local.test
DEMO_PASSWORD=demo-password
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=house-design
S3_REGION=us-east-1
BUDGET_USER_DAILY=100
BUDGET_PROJECT=50
BUDGET_TASK=10
